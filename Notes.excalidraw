      "fontSize": 20,
      "fontFamily": 6,
      "text": "import mongoose from \"mongoose\"\n\n\nconst connectDB=async()=>{\n\n          try{\n                    const connectionInstance=await mongoose.connect(`${process.env.MONGODB_URL}`)\n\n                    console.log(`MongoDB is connected DBHOST !! ${connectionInstance.connection.host}`)\n          }\n          catch(error){\n                    console.log(\"Mongodb connetion error !!\" );\n                    process.exit(1)\n          }\n          \n\n}\nexport default connectDB;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import mongoose from \"mongoose\"\n\n\nconst connectDB=async()=>{\n\n          try{\n                    const connectionInstance=await mongoose.connect(`${process.env.MONGODB_URL}`)\n\n                    console.log(`MongoDB is connected DBHOST !! ${connectionInstance.connection.host}`)\n          }\n          catch(error){\n                    console.log(\"Mongodb connetion error !!\" );\n                    process.exit(1)\n          }\n          \n\n}\nexport default connectDB;",
      "autoResize": false,
      "lineHeight": 1.35
