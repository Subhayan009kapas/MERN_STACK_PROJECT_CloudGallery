    {
      "id": "U-DrB43-_rwN__Ud4VEcV",
      "type": "text",
      "x": 1163.1080664074864,
      "y": 8205.354060332858,
      "width": 724.0183940997591,
      "height": 713.3036042427723,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 1591681512,
      "version": 375,
      "versionNonce": 1365568232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1730298343110,
      "link": null,
      "locked": false,
      "text": "import {v2 as cloudinary} from 'cloudinary'\nimport fs from'fs'\n\ncloudinary.config({\n          cloud_name:process.env.CLOUDINARY_CLOUD_NAME,\n          api_key:process.env.CLOUDINARY_API_KEY,\n          api_secret:process.env.CLOUDINARY_API_SECRET\n})\n\nconst uploadOnCloudinary=async(localFilePath)=>{\n          try{\n                    if(!localFilePath) return null;\n\n                    const response=await cloudinary.uploader.upload(localFilePath ,{\n                              resource_type:\"auto\"\n                    })\n                    console.log(\"File is uploaded on cloudinary\" , response.url)\n\n                    fs.unlinkSync(localFilePath)  // local server theke file gulo ke remove korbe\n\n                    return response;\n          }\n          catch(error){\n                    fs.unlinkSync(localFilePath)\n\n                    return  null;\n          }\n};\n\nexport {\n          uploadOnCloudinary\n}",
      "fontSize": 16.511657505619723,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import {v2 as cloudinary} from 'cloudinary'\nimport fs from'fs'\n\ncloudinary.config({\n          cloud_name:process.env.CLOUDINARY_CLOUD_NAME,\n          api_key:process.env.CLOUDINARY_API_KEY,\n          api_secret:process.env.CLOUDINARY_API_SECRET\n})\n\nconst uploadOnCloudinary=async(localFilePath)=>{\n          try{\n                    if(!localFilePath) return null;\n\n                    const response=await cloudinary.uploader.upload(localFilePath ,{\n                              resource_type:\"auto\"\n                    })\n                    console.log(\"File is uploaded on cloudinary\" , response.url)\n\n                    fs.unlinkSync(localFilePath)  // local server theke file gulo ke remove korbe\n\n                    return response;\n          }\n          catch(error){\n                    fs.unlinkSync(localFilePath)\n\n                    return  null;\n          }\n};\n\nexport {\n          uploadOnCloudinary\n}",
      "autoResize": true,
      "lineHeight": 1.35
    },
