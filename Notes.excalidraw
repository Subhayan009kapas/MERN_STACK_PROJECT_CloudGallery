      "text": "import mongoose, { Schema } from \"mongoose\"\n\nconst userSchema=new Schema({\n\n          username:{\n                    type:String,\n                    required:true,\n                    unique:true,\n          },\n          password:{\n                    type:String,\n                    required:true,\n\n          }\n\n})\nexport const User=mongoose.model(\"User\",userSchema)",
