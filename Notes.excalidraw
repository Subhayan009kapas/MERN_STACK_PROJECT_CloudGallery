      "fontSize": 16,
      "fontFamily": 6,
      "text": "// To fetch all the users \n  useEffect(()=>{\n   \n    const fetchUsers=async()=>{\n      try{\n        const response=await axios.get(\"http://localhost:3000/auth\")\n        setusers(response.data)\n      \n      }catch(error){\n        setError(error)\n      }\n    }\n    fetchUsers()\n\n  },[])",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// To fetch all the users \n  useEffect(()=>{\n   \n    const fetchUsers=async()=>{\n      try{\n        const response=await axios.get(\"http://localhost:3000/auth\")\n        setusers(response.data)\n      \n      }catch(error){\n        setError(error)\n      }\n    }\n    fetchUsers()\n\n  },[])",
      "autoResize": true,
      "lineHeight": 1.35
